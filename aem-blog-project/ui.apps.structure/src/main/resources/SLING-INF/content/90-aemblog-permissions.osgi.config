# OSGi config for org.apache.sling.jcr.repoinit.RepositoryInitializer
# File: 90-aemblog-permissions.osgi.config
scripts=[
    "
    # Create base paths if they don't exist
    create path (sling:Folder) /conf/aemblog/settings/workflow/models
    create path (sling:OrderedFolder) /content/dam/aemblog/posts
    create path (sling:OrderedFolder) /content/dam/aemblog/categories
    create path (sling:OrderedFolder) /content/dam/aemblog/tags
    create path (sling:OrderedFolder) /content/dam/aemblog/authors
    create path (sling:OrderedFolder) /content/dam/aemblog/comments

    # Create service user (example, if needed by services)
    # create service user aemblog-service-user with path system/cq:services/aemblog
    # set ACL for aemblog-service-user
    #   allow jcr:read on /content/dam/aemblog
    # end

    # Create groups
    create group blog-authors in namespace aemblog with path /home/groups/aemblog
    create group blog-admins in namespace aemblog with path /home/groups/aemblog

    # Set ACLs for blog-authors (example, needs refinement)
    set ACL for blog-authors
      allow jcr:read on /
      allow cq:read,rep:write,crx:replicate,dam:read,dam:write on /content/dam/aemblog
      # More specific paths:
      allow rep:write on /content/dam/aemblog/posts
      allow rep:write on /content/dam/aemblog/authors # allow authors to edit their profiles
      # Deny access to sensitive areas if necessary
    end

    # Set ACLs for blog-admins (example, needs refinement)
    set ACL for blog-admins
      allow jcr:all on /conf/aemblog
      allow jcr:all on /content/dam/aemblog
      allow jcr:all on /content/aemblog # Site content path
      allow jcr:all on /home/users/aemblog
      allow jcr:all on /home/groups/aemblog
      # Allow workflow management
      allow jcr:all on /var/workflow/models/aemblog
    end
    "
]
