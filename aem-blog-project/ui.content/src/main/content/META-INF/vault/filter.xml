<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <!-- Content Fragment Models -->
    <filter root="/conf/aemblog/settings/dam/cfm/models"/>

    <!-- Workflow Models -->
    <filter root="/conf/aemblog/settings/workflow/models"/>

    <!-- Editable Page Templates -->
    <filter root="/conf/aemblog/settings/wcm/templates"/>
    <filter root="/conf/aemblog/settings/wcm/template-types"/>
    <filter root="/conf/aemblog/settings/wcm/policies"/>

    <!-- Site Content Root (usually minimal in ui.content, actual content authored in AEM) -->
    <filter root="/content/aemblog"/>

    <!-- Digital Asset Management (DAM) content -->
    <filter root="/content/dam/aemblog">
        <!-- Example: Exclude renditions from ui.content package, they are generated by AEM -->
        <exclude pattern="/content/dam/aemblog(/.*)?/jcr:content/renditions(/.*)?"/>
    </filter>

    <!-- Language Masters if any -->
    <!-- <filter root="/content/aemblog/language-masters"/> -->

</workspaceFilter>
