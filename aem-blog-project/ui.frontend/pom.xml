<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>aem-blog-project</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aem-blog-project.ui.frontend</artifactId>
    <packaging>pom</packaging> <!-- Typically 'pom' as it orchestrates frontend build -->
    <name>AEM Blog Project - UI Frontend</name>
    <description>Handles the build of client-side libraries (CSS, JS) for AEM Blog Project.</description>

    <properties>
        <node.version>v16.13.0</node.version> <!-- Specify Node.js version -->
        <npm.version>8.1.0</npm.version>   <!-- Specify NPM version (or yarn.version) -->
        <frontend.src.directory>src/main/frontend</frontend.src.directory> <!-- Or src/main/webpack, etc. -->
    </properties>

    <build>
        <pluginManagement> <!-- Manage plugin versions in parent or here if specific -->
            <plugins>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                    <configuration>
                        <nodeVersion>${node.version}</nodeVersion>
                        <npmVersion>${npm.version}</npmVersion>
                        <workingDirectory>${frontend.src.directory}</workingDirectory>
                        <!-- Alternatively, if package.json is at module root:
                        <workingDirectory>${project.basedir}</workingDirectory>
                        -->
                    </configuration>
                    <executions>
                        <execution>
                            <id>install node and npm</id>
                            <goals>
                                <goal>install-node-and-npm</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>npm install</id>
                            <goals>
                                <goal>npm</goal>
                            </goals>
                            <configuration>
                                <arguments>install</arguments>
                            </configuration>
                        </execution>
                        <execution>
                            <id>npm run build</id> <!-- Or 'yarn build', 'webpack build' etc. -->
                            <goals>
                                <goal>npm</goal>
                            </goals>
                            <configuration>
                                <arguments>run build</arguments> <!-- Assumes 'build' script in package.json -->
                            </configuration>
                        </execution>
                        <!-- Add executions for linting, testing if needed -->
                        <!--
                        <execution>
                            <id>npm run test</id>
                            <goals>
                                <goal>npm</goal>
                            </goals>
                            <phase>test</phase>
                            <configuration>
                                <arguments>run test</arguments>
                            </configuration>
                        </execution>
                        -->
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins> <!-- Invoke the managed plugin -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
